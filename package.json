{
  "name": "flowstate-fps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "art:build": "node tools/art/build-assets.mjs",
    "art:sync-metadata": "node tools/art/sync-art-metadata.mjs",
    "art:textures": "node tools/art/build-surface-textures.mjs",
    "art:validate": "node tools/art/validate-assets.mjs && node tools/art/validate-surface-textures.mjs && node tools/art/validate-runtime-art-budget.mjs",
    "art:transcoders": "node tools/art/sync-three-transcoders.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recast-navigation": "0.43.1",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
